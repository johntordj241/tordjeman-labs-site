# Variables réservées à l'atelier interne
# Exemple : VITE_INTERNAL_API_URL=https://atelier.tordjeman-labs.local

# Identifiant YouTube de l'animation officielle (format embed)
VITE_BRAND_VIDEO_ID=u36YO2u6dLM

# Google Analytics 4 (optionnel en dev, requis en prod)
# Ne remplir que avec identifiant réel, jamais de valeur test
VITE_GA_MEASUREMENT_ID=

# Google Search Console verification (optionnel)
# Balise de vérification HTML à placer dans index.html après obtention de Google
VITE_GSC_VERIFICATION_ID=
